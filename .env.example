# Anthropic API key (required)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Gmail account used to send the daily digest (required)
GMAIL_ADDRESS=wclober1@gmail.com

# Gmail App Password (required) — NOT your normal login password.
# Create one at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your-16-char-app-password

# Optional: override recipient (defaults to GMAIL_ADDRESS)
EMAIL_TO=wclober1@gmail.com

# Always send a morning email, even when nothing scores 7+ (default: 1)
ALWAYS_EMAIL_DIGEST=1
