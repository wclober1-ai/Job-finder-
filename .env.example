# Anthropic API key (required)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Gmail account used to send the daily digest (required)
GMAIL_ADDRESS=wclober1@gmail.com

# Gmail App Password (required) — NOT your normal login password.
# Create one at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your-16-char-app-password

# Optional: override recipient (defaults to GMAIL_ADDRESS)
# EMAIL_TO=wclober1@gmail.com

# ---------------------------------------------------------------------------
# Broader keyword job search
# ---------------------------------------------------------------------------

# Adzuna (optional) — free API key at https://developer.adzuna.com/
# Best source for broader US keyword search. Leave blank to skip.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
# Optional location filter, e.g. "California" or "San Francisco"
ADZUNA_WHERE=
ADZUNA_RESULTS_PER_QUERY=20
ADZUNA_MAX_PAGES=1

# Free public feeds (no API key). Set to 0 to disable either source.
REMOTEOK_ENABLED=1
ARBEITNOW_ENABLED=1
